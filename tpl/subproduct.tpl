{{HEAD}}
<body style="--accent: {{ACCENT_COLOR}};">

  <!-- Skip to main content (accessibility) -->
  <a class="sr-only" href="#main-content">Skip to main content</a>

  <main id="main-content" class="subpage-wrap">

    <div class="subpage-logo-wrap" role="img" aria-label="{{PRODUCT_NAME}} logo">
      <img src="{{LOGO_PATH}}" alt="{{PRODUCT_NAME}}">
    </div>

    <span class="subpage-category" aria-label="Category: {{CATEGORY}}">{{CATEGORY}}</span>
    <h1 class="subpage-name">{{PRODUCT_NAME}}</h1>
    <p class="subpage-tagline">{{TAGLINE}}</p>

    <nav class="subpage-links" aria-label="{{PRODUCT_NAME}} social links">
{{LINKS}}
    </nav>

{{FOOTER}}
  </main>

</body>
</html>
